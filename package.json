{
  "name": "tourism-platform",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.4.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "turbo run build",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "test:e2e": "playwright test tests/e2e",
    "test:a11y": "playwright test tests/a11y",
    "test:all": "playwright test",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "smoke:onboarding": "bash scripts/onboarding-smoke.sh http://localhost:3000",
    "postinstall": "pnpm --filter @weblynk/db run db:generate || true",
    "smoke:ui": "node scripts/smoke-ui.mjs",
    "db:validate": "env $(cat packages/db/.env | xargs) pnpm --filter @weblynk/db exec prisma validate",
    "db:generate": "env $(cat packages/db/.env | xargs) pnpm --filter @weblynk/db exec prisma generate",
    "db:migrate-deploy": "env $(cat packages/db/.env | xargs) pnpm --filter @weblynk/db exec prisma migrate deploy",
    "ci:secrets-check": "./ci-secret-check.sh",
    "ci:rls-check": "./ci-rls-check.sh",
    "ci:build-validation": "./ci-build-validation.sh",
    "ci:db-validation": "./ci-db-validation.sh",
    "ci:security-check": "./quick-security-check.sh",
    "test:e2e:ci": "playwright test tests/e2e/smoke.spec.ts",
    "preinstall": "node scripts/vercel-preinstall.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.8.0",
    "@playwright/test": "^1.40.0",
    "@tailwindcss/postcss": "^4",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "autoprefixer": "^10",
    "eslint": "^8.0.0",
    "lint-staged": "^16.2.4",
    "postcss": "^8",
    "tailwindcss": "^4",
    "turbo": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "@trpc/client": "^10.45.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix"
    ]
  }
}
