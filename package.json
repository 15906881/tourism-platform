{
  "name": "tourism-platform",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "lint": "eslint . --ext .js,.ts --fix",
    "lint:check": "eslint . --ext .js,.ts",
    "format:check": "prettier --check \"**/*.{js,ts,json,yml,yaml}\"",
    "format": "prettier --write \"**/*.{js,ts,json,yml,yaml}\"",
    "db:migrate": "bash scripts/migrate.sh",
    "db:init": "./scripts/db_init.sh",
    "api:dev": "node api/server.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "eslint": "^9.10.0",
    "globals": "^15.0.0",
    "markdownlint-cli": "^0.41.0",
    "prettier": "^3.3.3"
  }
}
