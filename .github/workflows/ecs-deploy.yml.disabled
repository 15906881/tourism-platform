name: Deploy to ECS

on:
  workflow_dispatch:
    inputs:
      app:
        description: 'App to deploy'
        required: true
        default: 'tenant-dashboard'
        type: choice
        options:
        - tenant-dashboard
        - admin
        - site-renderer
        - onboarding
        - photos-entry
      environment:
        description: 'Environment'
        required: true
        default: 'staging'
        type: choice
        options:
        - staging
        - production

env:
  AWS_REGION: us-east-1

jobs:
  deploy:
    runs-on: ubuntu-latest
    environment: ${{ github.event.inputs.environment || 'staging' }}
    
    steps:
    - name: Checkout
      uses: actions/checkout@v4
    
    - name: Configure AWS credentials
      uses: aws-actions/configure-aws-credentials@v4
      with:
        role-to-assume: ${{ secrets.AWS_ROLE_ARN }}
        aws-region: ${{ env.AWS_REGION }}
    
    - name: Deploy to ECS
      run: |
        echo "Deploying ${{ github.event.inputs.app }} to ${{ github.event.inputs.environment }}"
        # Add actual ECS deployment commands here
        echo "TODO: Implement ECS deployment for ${{ github.event.inputs.app }}"
