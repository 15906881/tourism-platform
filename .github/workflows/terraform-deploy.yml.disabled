name: Terraform Plan and Apply

on:
  push:
    branches: [develop, test-terraform-workflow]
  pull_request:
    branches: [main, develop]
  workflow_dispatch:

env:
  AWS_REGION: us-east-1
  TF_WORKING_DIR: infra/phase-2/environments

jobs:
  terraform-plan:
    name: Terraform Plan
    runs-on: ubuntu-latest
    
    steps:
    - name: Checkout
      uses: actions/checkout@v3
    
    - name: Configure AWS credentials
      uses: aws-actions/configure-aws-credentials@v4
      with:
        role-to-assume: ${{ secrets.AWS_ROLE_ARN }}
        aws-region: ${{ env.AWS_REGION }}
    
    - name: Setup Terraform
      uses: hashicorp/setup-terraform@v2
    
    - name: Terraform Init
      working-directory: ${{ env.TF_WORKING_DIR }}/staging
      run: terraform init
    
    - name: Terraform Format Check
      working-directory: ${{ env.TF_WORKING_DIR }}/staging
      run: terraform fmt -check
      continue-on-error: true
    
    - name: Terraform Validate
      working-directory: ${{ env.TF_WORKING_DIR }}/staging
      run: terraform validate -no-color
    
    - name: Terraform Plan
      working-directory: ${{ env.TF_WORKING_DIR }}/staging
      run: terraform plan -no-color -input=false -out=tfplan
    
    - name: Upload Terraform Plan
      uses: actions/upload-artifact@v4
      with:
        name: terraform-plan
        path: ${{ env.TF_WORKING_DIR }}/staging/tfplan

  manual-approval:
    name: Manual Approval
    runs-on: ubuntu-latest
    needs: [terraform-plan]
    environment: staging
    if: github.event_name == 'push'
    
    steps:
    - name: Wait for approval
      run: echo "Deployment requires approval via GitHub Environment protection rules"

  terraform-apply:
    name: Terraform Apply
    runs-on: ubuntu-latest
    needs: [manual-approval]
    environment: staging
    if: github.event_name == 'push'
    
    steps:
    - name: Checkout
      uses: actions/checkout@v3
    
    - name: Configure AWS credentials
      uses: aws-actions/configure-aws-credentials@v4
      with:
        role-to-assume: ${{ secrets.AWS_ROLE_ARN }}
        aws-region: ${{ env.AWS_REGION }}
    
    - name: Download Terraform Plan
      uses: actions/download-artifact@v4
      with:
        name: terraform-plan
        path: ${{ env.TF_WORKING_DIR }}/staging
    
    - name: Setup Terraform
      uses: hashicorp/setup-terraform@v2
    
    - name: Terraform Init
      working-directory: ${{ env.TF_WORKING_DIR }}/staging
      run: terraform init
    
    - name: Terraform Apply
      working-directory: ${{ env.TF_WORKING_DIR }}/staging
      run: terraform apply -auto-approve -input=false tfplan
