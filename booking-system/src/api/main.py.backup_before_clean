@app.get('/health')
async def health_check():
    try:
        async with pool.acquire() as conn:
            db_ok = await conn.fetchval('SELECT 1')
            return {
                'status': 'healthy',
                'database': 'connected',
                'tenants': await conn.fetchval('SELECT COUNT(*) FROM tenants'),
