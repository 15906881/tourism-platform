# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/tourism_dev?schema=core&search_path=core,public

# Cognito Authentication
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_JWKS_URL=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_xxxxxxxxx/.well-known/jwks.json

# NextAuth
NEXTAUTH_SECRET=change-this-to-a-secure-random-string-in-production
NEXTAUTH_URL=http://localhost:3000

# Onboarding
ONBOARDING_BACKEND=stub
ONBOARDING_SIGNING_SECRET=change-this-to-a-secure-random-string

# Application Specific
DEBUG_TENANT_ID=stub-tenant-0001
DEBUG_ROLE=admin
DEBUG_ONBOARDING=0

# Deployment
PRISMA_CLIENT_ENGINE_TYPE=library
