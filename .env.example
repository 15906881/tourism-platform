NODE_ENV=development
LOG_LEVEL=info
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/tourism_platform
JWT_SECRET=change-this-to-a-secret-min-32-characters-long
SESSION_MAX_AGE=86400
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
TRPC_MAX_BODY=10mb
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=900000

# AWS Cognito
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_JWKS_URL=
COGNITO_CLIENT_ID=
