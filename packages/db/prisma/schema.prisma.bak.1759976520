generator client {
  provider = "prisma-client-js"
  output   = "../../apps/tenant-dashboard/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model accounts {
  id          String        @id @default(cuid())
  email       String        @unique
  created_at  DateTime      @default(now())
  memberships memberships[]
}

model tenants {
  id               String             @id @default(cuid())
  name             String             @unique
  created_at       DateTime?          @default(now())
  users            users[]
}

model users {
  id         String    @id @default(cuid())
  tenant_id  String?
  email      String    @unique
  role       String    @default("member")
  created_at DateTime? @default(now())
  tenants    tenants?  @relation(fields: [tenant_id], references: [id])
}
