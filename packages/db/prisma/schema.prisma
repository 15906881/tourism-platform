generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Add your actual model definitions here
model tenants {
  id   String @id @default(cuid())
  name String @unique
}

model users {
  id        String   @id @default(cuid())
  tenant_id String?
  email     String   @unique
  role      String   @default("member")
}
