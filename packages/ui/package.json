{
  "name": "@weblynk/ui",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles/a11y.css": "./dist/styles/a11y.css"
  },
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build": "tsc -p tsconfig.json && mkdir -p dist/styles && [ -f src/styles/a11y.css ] && cp -f src/styles/a11y.css dist/styles/a11y.css || true",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^9.1.13",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/react-vite": "^9.1.13",
    "@storybook/test": "^8.6.14",
    "storybook": "^9.1.13",
    "typescript": "^5.0.0",
    "vite": "^7.1.10"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.0"
  }
}
