{
  "name": "@weblynk/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles/a11y.css": "./dist/styles/a11y.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/styles && cp src/styles/a11y.css dist/styles/a11y.css",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "engines": {
    "node": ">=20.19.5"
  }
}
