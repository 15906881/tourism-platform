{
  "name": "@weblynk/ui",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./styles/a11y.css": "./dist/styles/a11y.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/styles && [ -f src/styles/a11y.css ] && cp -f src/styles/a11y.css dist/styles/a11y.css || true",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.0"
  }
}