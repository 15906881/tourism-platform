{
  "name": "@weblynk/blocks",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./shared": {
      "types": "./dist/shared/index.d.ts",
      "default": "./dist/shared/index.js"
    },
    "./service-booking": {
      "types": "./dist/service-booking/index.d.ts",
      "default": "./dist/service-booking/index.js"
    },
    "./hospitality": {
      "types": "./dist/hospitality/index.d.ts",
      "default": "./dist/hospitality/index.js"
    },
    "./professional": {
      "types": "./dist/professional/index.d.ts",
      "default": "./dist/professional/index.js"
    },
    "./food": {
      "types": "./dist/food/index.d.ts",
      "default": "./dist/food/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@weblynk/ui": "^0.1.0"
  },
  "dependencies": {
    "clsx": "^2.1.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "typescript": "^5.3.0",
    "@weblynk/ui": "workspace:*"
  },
  "engines": {
    "node": ">=20.19.5",
    "pnpm": ">=9.12.0"
  }
}
