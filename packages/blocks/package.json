{
  "name": "@weblynk/blocks",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./shared": {
      "types": "./dist/shared/index.d.ts",
      "default": "./dist/shared/index.js"
    },
    "./service-booking": {
      "types": "./dist/service-booking/index.d.ts",
      "default": "./dist/service-booking/index.js"
    },
    "./hospitality": {
      "types": "./dist/hospitality/index.d.ts",
      "default": "./dist/hospitality/index.js"
    },
    "./professional": {
      "types": "./dist/professional/index.d.ts",
      "default": "./dist/professional/index.js"
    },
    "./food": {
      "types": "./dist/food/index.d.ts",
      "default": "./dist/food/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@weblynk/ui": "^0.0.1"
  },
  "dependencies": {
    "clsx": "^2.1.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "typescript": "^5.3.0",
    "@weblynk/ui": "workspace:*"
  }
}
