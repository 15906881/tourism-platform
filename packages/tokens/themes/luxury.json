/**
 * Weblynk Luxury Design Tokens
 * High-end aesthetic for tourism/hospitality platform
 */

:root {
  /* ===================================
     Color Palette
     =================================== */
  
  /* Backgrounds */
  --color-bg: #0F1115;
  --color-surface: #141821;
  --color-surface-2: #191E28;
  --color-surface-3: #1F2533;
  
  /* Text */
  --color-text: #EAEAF0;
  --color-text-muted: #A6A9B6;
  --color-text-subtle: #6B7280;
  
  /* Primary (Champagne Gold) */
  --color-primary: #C5A572;
  --color-primary-hover: #D4B583;
  --color-primary-rgb: 197, 165, 114;
  
  /* Accent (Amethyst) */
  --color-accent: #6B4E9A;
  --color-accent-hover: #7D5CAB;
  
  /* Borders */
  --color-border: rgba(255, 255, 255, 0.08);
  --color-border-focus: rgba(197, 165, 114, 0.3);
  
  /* States */
  --color-disabled: rgba(255, 255, 255, 0.05);
  --color-error: #DC2626;
  --color-success: #10B981;
  --color-warning: #F59E0B;
  
  /* ===================================
     Gradients
     =================================== */
  
  --gradient-gold: linear-gradient(135deg, #C5A572 0%, #D4B583 100%);
  --gradient-surface: linear-gradient(180deg, #141821 0%, #0F1115 100%);
  --gradient-overlay: linear-gradient(180deg, rgba(15, 17, 21, 0) 0%, rgba(15, 17, 21, 0.8) 100%);
  
  /* ===================================
     Shadows
     =================================== */
  
  --shadow-sm: 0 2px 12px rgba(0, 0, 0, 0.25);
  --shadow-md: 0 8px 30px rgba(0, 0, 0, 0.35);
  --shadow-lg: 0 16px 48px rgba(0, 0, 0, 0.45);
  --shadow-glow: 0 0 24px rgba(197, 165, 114, 0.15);
  
  /* ===================================
     Border Radius
     =================================== */
  
  --radius-xs: 6px;
  --radius-sm: 10px;
  --radius-md: 14px;
  --radius-lg: 18px;
  --radius-xl: 24px;
  --radius-pill: 999px;
  
  /* ===================================
     Spacing
     =================================== */
  
  --space-xs: 8px;
  --space-sm: 12px;
  --space-md: 16px;
  --space-lg: 24px;
  --space-xl: 36px;
  --space-xxl: 56px;
  --space-xxxl: 80px;
  
  /* ===================================
     Typography
     =================================== */
  
  /* Font Families */
  --font-heading: "Cormorant Garamond", "Playfair Display", ui-serif, Georgia, serif;
  --font-body: "Inter", -apple-system, system-ui, sans-serif;
  
  /* Font Weights */
  --weight-regular: 400;
  --weight-medium: 500;
  --weight-semibold: 600;
  --weight-bold: 700;
  
  /* Font Sizes */
  --type-h1: 48px;
  --type-h2: 36px;
  --type-h3: 24px;
  --type-h4: 20px;
  --type-body: 16px;
  --type-small: 14px;
  --type-label: 13px;
  --type-cap: 11px;
  
  /* Line Heights */
  --leading-tight: 1.2;
  --leading-normal: 1.5;
  --leading-relaxed: 1.75;
  
  /* ===================================
     Motion
     =================================== */
  
  /* Easing Functions */
  --easing-standard: cubic-bezier(0.22, 0.61, 0.36, 1);
  --easing-decelerate: cubic-bezier(0.05, 0.7, 0.1, 1.0);
  --easing-sharp: cubic-bezier(0.4, 0.0, 0.2, 1);
  
  /* Durations */
  --duration-fast: 180ms;
  --duration-standard: 350ms;
  --duration-slow: 500ms;
  
  /* ===================================
     CTA Styles
     =================================== */
  
  --cta-weight: 600;
  --cta-letter-spacing: 0.5px;
  --cta-padding: 14px 32px;
}

/* ===================================
   Utility Classes
   =================================== */

/* Text Colors */
.text-primary { color: var(--color-primary); }
.text-muted { color: var(--color-text-muted); }
.text-subtle { color: var(--color-text-subtle); }
.text-error { color: var(--color-error); }
.text-success { color: var(--color-success); }

/* Backgrounds */
.bg-surface { background-color: var(--color-surface); }
.bg-surface-2 { background-color: var(--color-surface-2); }
.bg-surface-3 { background-color: var(--color-surface-3); }
.bg-primary { background: var(--gradient-gold); }

/* Borders */
.border { border: 1px solid var(--color-border); }
.border-focus { border-color: var(--color-border-focus); }

/* Shadows */
.shadow-sm { box-shadow: var(--shadow-sm); }
.shadow-md { box-shadow: var(--shadow-md); }
.shadow-lg { box-shadow: var(--shadow-lg); }
.glow { box-shadow: var(--shadow-glow); }

/* Radius */
.rounded-sm { border-radius: var(--radius-sm); }
.rounded-md { border-radius: var(--radius-md); }
.rounded-lg { border-radius: var(--radius-lg); }
.rounded-xl { border-radius: var(--radius-xl); }
.rounded-pill { border-radius: var(--radius-pill); }

/* ===================================
   Typography Classes
   =================================== */

h1, .h1 {
  font-family: var(--font-heading);
  font-size: var(--type-h1);
  font-weight: var(--weight-semibold);
  line-height: var(--leading-tight);
  color: var(--color-text);
}

h2, .h2 {
  font-family: var(--font-heading);
  font-size: var(--type-h2);
  font-weight: var(--weight-semibold);
  line-height: var(--leading-tight);
  color: var(--color-text);
}

h3, .h3 {
  font-family: var(--font-heading);
  font-size: var(--type-h3);
  font-weight: var(--weight-semibold);
  line-height: var(--leading-normal);
  color: var(--color-text);
}

h4, .h4 {
  font-family: var(--font-body);
  font-size: var(--type-h4);
  font-weight: var(--weight-semibold);
  line-height: var(--leading-normal);
  color: var(--color-text);
}

body, p, .body {
  font-family: var(--font-body);
  font-size: var(--type-body);
  font-weight: var(--weight-regular);
  line-height: var(--leading-relaxed);
  color: var(--color-text);
}

.small {
  font-size: var(--type-small);
  line-height: var(--leading-normal);
}

.label {
  font-size: var(--type-label);
  font-weight: var(--weight-medium);
  line-height: var(--leading-normal);
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.caption {
  font-size: var(--type-cap);
  line-height: var(--leading-normal);
  color: var(--color-text-subtle);
}

/* ===================================
   Component: Button (Primary CTA)
   =================================== */

.btn-primary {
  font-family: var(--font-body);
  font-size: var(--type-body);
  font-weight: var(--cta-weight);
  letter-spacing: var(--cta-letter-spacing);
  padding: var(--cta-padding);
  
  background: var(--gradient-gold);
  color: var(--color-bg);
  border: none;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
  
  cursor: pointer;
  transition: all var(--duration-standard) var(--easing-standard);
}

.btn-primary:hover {
  transform: translateY(-2px);
  box-shadow: var(--shadow-md), var(--shadow-glow);
}

.btn-primary:active {
  transform: translateY(0);
  box-shadow: var(--shadow-sm);
}

.btn-primary:disabled {
  opacity: 0.4;
  cursor: not-allowed;
  transform: none;
}

/* ===================================
   Component: Button (Secondary)
   =================================== */

.btn-secondary {
  font-family: var(--font-body);
  font-size: var(--type-body);
  font-weight: var(--cta-weight);
  letter-spacing: var(--cta-letter-spacing);
  padding: var(--cta-padding);
  
  background: transparent;
  color: var(--color-primary);
  border: 1px solid var(--color-primary);
  border-radius: var(--radius-md);
  
  cursor: pointer;
  transition: all var(--duration-standard) var(--easing-standard);
}

.btn-secondary:hover {
  background: rgba(197, 165, 114, 0.1);
  box-shadow: var(--shadow-glow);
}

/* ===================================
   Component: Card
   =================================== */

.card {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  padding: var(--space-lg);
  
  transition: all var(--duration-standard) var(--easing-standard);
}

.card:hover {
  border-color: rgba(197, 165, 114, 0.2);
  box-shadow: var(--shadow-md);
  transform: translateY(-2px);
}

/* ===================================
   Component: Input
   =================================== */

.input {
  font-family: var(--font-body);
  font-size: var(--type-body);
  padding: 12px 16px;
  
  background: var(--color-surface-2);
  color: var(--color-text);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  
  transition: all var(--duration-fast) var(--easing-standard);
}

.input:focus {
  outline: none;
  border-color: var(--color-border-focus);
  box-shadow: 0 0 0 3px rgba(197, 165, 114, 0.1);
}

.input::placeholder {
  color: var(--color-text-subtle);
}

/* ===================================
   Animations
   =================================== */

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes slideUp {
  from { 
    opacity: 0;
    transform: translateY(20px);
  }
  to { 
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes glow {
  0%, 100% { box-shadow: var(--shadow-glow); }
  50% { box-shadow: 0 0 32px rgba(197, 165, 114, 0.25); }
}

.fade-in {
  animation: fadeIn var(--duration-standard) var(--easing-standard);
}

.slide-up {
  animation: slideUp var(--duration-standard) var(--easing-decelerate);
}

.pulse-glow {
  animation: glow 2s var(--easing-standard) infinite;
}

/* ===================================
   Responsive Typography
   =================================== */

@media (max-width: 768px) {
  :root {
    --type-h1: 36px;
    --type-h2: 28px;
    --type-h3: 20px;
    --type-h4: 18px;
  }
}

@media (max-width: 480px) {
  :root {
    --type-h1: 32px;
    --type-h2: 24px;
    --type-h3: 18px;
    --space-xl: 24px;
    --space-xxl: 36px;
  }
}
